# Contact form (app/contact/actions.ts). Copy to .env.local for local dev,
# and add the same two in your host's environment settings (e.g. Vercel).

# API key from https://resend.com/api-keys (sending access is enough).
RESEND_API_KEY=re_xxxxxxxxxxxx

# Who the emails come from. Must be on a domain verified in Resend.
CONTACT_FROM="ESA Portfolio <contact@esa-audio.se>"
