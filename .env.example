# Contact form (app/contact/actions.ts). Copy to .env.local for local dev,
# and add the same two in your host's environment settings (e.g. Vercel),
# then redeploy.

# API key from https://resend.com/api-keys (sending access is enough).
RESEND_API_KEY=re_xxxxxxxxxxxx

# Who the emails come from. The address must be on a domain verified in
# Resend (esa-audio.se); the name in front can be anything. On Vercel,
# enter the value without the surrounding quotes.
CONTACT_FROM="ESA Sound Production <contact@esa-audio.se>"
